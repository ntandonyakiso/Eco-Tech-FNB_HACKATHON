# Eco-Tech environment variables — copy to .env, fill in real values, never commit
# Backend
DATABASE_URL=jdbc:postgresql://localhost:5432/ecotech
DB_USERNAME=postgres
DB_PASSWORD=postgres
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=*

# Storage
STORAGE_LOCAL_PATH=./uploads
SUPABASE_STORAGE_BUCKET=reports
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Web Push VAPID (generate with: node -e "const {generateVapidKeys}=require('web-push');console.log(JSON.stringify(generateVapidKeys()))")
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ecotech.local

# Alerts
ALERTS_INGEST_INTERVAL_MS=900000

# EskomSePush load shedding (optional — stub/console when not set)
ESKOM_BASE_URL=https://developer.sepush.co.za/business/2.0
ESKOM_API_KEY=

# Usage tariffs (ZAR per unit) — optional, defaults used when not set
APP_USAGE_WATER_TARIFF=
APP_USAGE_ENERGY_TARIFF=

# Open-Meteo weather (no key required)
APP_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
