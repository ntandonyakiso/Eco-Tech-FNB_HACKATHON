# Eco-Tech Backend Environment Variables
# Copy to .env and fill in real values. Never commit this file.

# Database (Supabase PostgreSQL + PostGIS)
DATABASE_URL=jdbc:postgresql://db.<supabase-project>.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=<your-supabase-db-password>

# JWT
JWT_SECRET=<long-random-secret-min-256-bits>
JWT_EXPIRATION_MS=86400000

# CORS
CORS_ALLOWED_ORIGINS=https://ecotech-frontend.netlify.app,http://localhost:5173

# Telegram Bot (Phase 3)
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>

# Web Push VAPID (Phase 3)
VAPID_PUBLIC_KEY=<base64url public key>
VAPID_PRIVATE_KEY=<base64url private key>
VAPID_SUBJECT=mailto:admin@ecotech.local

# Africa's Talking SMS (Phase 3, fallback behind interface)
AFRICASTALKING_USERNAME=<sandbox username>
AFRICASTALKING_API_KEY=<sandbox api key>

# Open-Meteo (no key needed)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# EskomSePush (behind interface with fallback)
ESKOM_SE_PUSH_API_KEY=<optional key>
ESKOM_SE_PUSH_BASE_URL=https://developer.sepush.co.za/business/2.0
